# Supabase 연결(공개 읽기용) — 클라이언트에 노출되는 값. 필수.
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ─── 아래는 "로컬 작성 폼"에서만 사용 (개발 전용) ───────────────
# ⚠ service_role 키는 RLS를 우회합니다. VITE_ 접두사 금지(번들 노출 방지),
#    절대 커밋/Vercel 환경변수에 넣지 마세요. .env.local 에만 둡니다.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
# cross-origin 위조 POST 차단용 약한 토큰(노출돼도 무방). 임의 문자열.
VITE_DEV_WRITE_TOKEN=dev-local-only
